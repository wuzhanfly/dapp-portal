# Production Environment Configuration for BSC zkStack Portal

# Node Configuration
NODE_TYPE=hyperchain
NODE_ENV=production

# Wallet Connect - Replace with your own Project ID
WALLET_CONNECT_PROJECT_ID=a1be95859dbb2348a4aa5c370a0cae57

# Ankr Configuration (optional - for faster L1 balance loading)
ANKR_TOKEN=

# Sentry Error Monitoring (optional)
SENTRY_DSN=
SENTRY_ENV=production

# Analytics (optional)
RUDDER_KEY=
DATAPLANE_URL=

# Build Information
GIT_COMMIT_HASH=docker-build
GIT_REPO_URL=https://github.com/matter-labs/dapp-portal

# Onramp Configuration
ONRAMP_STAGING=false

# Screening API (optional)
SCREENING_API_URL=