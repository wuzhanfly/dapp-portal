#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Unset PREFIX to avoid conflicts with nvm
unset PREFIX

# Ensure npm/npx are available in PATH
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Add common npm paths to PATH
export PATH="$PATH:$HOME/.nvm/versions/node/v22.21.0/bin:$(npm config get prefix)/bin:/usr/local/bin:/usr/bin"

npx --no-install commitlint --edit "$1"
